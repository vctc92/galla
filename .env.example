# ---------- Agora (console.agora.io) ----------
AGORA_APP_ID=
AGORA_APP_CERT=
# RESTful API credentials (Console -> Developer Toolkit -> RESTful API)
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ---------- Speech recognition ----------
# ares (Agora built-in, default) | sarvam (better for Indian code-mixed speech)
ASR_VENDOR=ares
SARVAM_API_KEY=

# ---------- Murf Falcon TTS ----------
MURF_API_KEY=
MURF_VOICE_HI=hi-IN-karan
MURF_VOICE_TA=ta-IN-iniya
MURF_MODEL=FALCON

# ---------- LLM (OpenAI or any OpenAI-compatible provider) ----------
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# ---------- Telegram (@BotFather) ----------
TELEGRAM_BOT_TOKEN=
TG_CHAT_SHOPKEEPER=
TG_CHAT_CUSTOMER=
# optional; supplier reorder messages fall back to shopkeeper chat
TG_CHAT_SUPPLIER=

# ---------- App ----------
# Public HTTPS URL of this backend (ngrok). Agora cloud calls PUBLIC_URL/llm/...
PUBLIC_URL=http://localhost:8000
SHOP_NAME=Lakshmi Kirana Store
SHOP_UPI_ID=lakshmikirana@upi
# Reply script for the agent: native (Devanagari/Tamil script, best TTS) | latin (romanised Hinglish/Tanglish)
REPLY_SCRIPT=native
FOLLOWUP_DELAY_SECONDS=60
MAX_FOLLOWUPS=1
